<mxfile host="app.diagrams.net"><diagram name="02-home" id="screen-02"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E293B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="820" height="560" as="geometry"/></mxCell><mxCell id="hdr" value="2. Басты бет / Алматы жол қаупі картасы (Т1, Т2, Т3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="820" height="50" as="geometry"/></mxCell><mxCell id="btn_out" value="Шығу (Кіру экраны)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="40" width="150" height="30" as="geometry"/></mxCell><mxCell id="m1" value="+ Жаңа болжау жасау" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="200" height="38" as="geometry"/></mxCell><mxCell id="m2" value="Болжамдар тізімі" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="170" height="38" as="geometry"/></mxCell><mxCell id="m3" value="Статистика және есеп" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="180" height="38" as="geometry"/></mxCell><mxCell id="map" value="[ Алматы қаласының интерактивті жол желісі картасы ]&#xa;&#xa;• Әл-Фараби даңғылы — Қызыл (Жоғары қауіп, көктайғақ)&#xa;• Сәтбаев көшесі — Сары (Орташа қауіп, қар)&#xa;• Төле би көшесі — Жасыл (Төмен қауіп, қалыпты)&#xa;• Абай даңғылы — Қызыл (Жоғары қауіп, тұман)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;align=left;verticalAlign=top;spacing=15;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="160" width="760" height="290" as="geometry"/></mxCell><mxCell id="c_red" value="Қызыл: Жоғары қауіп (2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="475" width="230" height="42" as="geometry"/></mxCell><mxCell id="c_yel" value="Сары: Орташа қауіп (1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAB308;strokeColor=#EAB308;fontColor=#1E293B;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="355" y="475" width="230" height="42" as="geometry"/></mxCell><mxCell id="c_grn" value="Жасыл: Төмен қауіп (1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="475" width="230" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>