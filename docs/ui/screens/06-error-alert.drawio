<mxfile host="app.diagrams.net"><diagram name="06-error-alert" id="screen-06"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E293B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="660" height="430" as="geometry"/></mxCell><mxCell id="hdr" value="6. Қате хабарламасы (Т3, Т7 — Sequence alt қате тармағы)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="660" height="48" as="geometry"/></mxCell><mxCell id="box" value="&lt;b&gt;Болжау сақталмады: деректер форматы немесе міндетті өріс дұрыс емес.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Не істеу керек: «Болжау формасына қайту» батырмасын басып, күн/уақытты ЖЖЖЖ-АА-КК СС:ММ форматында енгізіңіз және бос қалған ескерту өрісін толтырып, қайта сақтаңыз." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;align=left;verticalAlign=middle;spacing=18;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="580" height="170" as="geometry"/></mxCell><mxCell id="btn_fix" value="Болжау формасына қайту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="330" width="230" height="42" as="geometry"/></mxCell><mxCell id="btn_home" value="Басты бетке қайту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="330" width="180" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>